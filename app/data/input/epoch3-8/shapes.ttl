@prefix base:   <https://neurosymbols.ai/ontology/causal-terminology.owl#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Declare namespace
base:
  sh:declare [
    sh:prefix "base" ;
    sh:namespace "https://neurosymbols.ai/ontology/causal-terminology.owl#" ;
  ] .

base:ObservationShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes base: ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a base:ParameterObservation .
                ?this base:hasObservedValue ?ovalue .
                ?spec a base:ParameterSpecification .
                ?spec base:hasUpperValue ?uspec .
                ?this base:isAbout ?spec .
                FILTER(?ovalue > ?uspec)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes base: ;
        sh:message "Observations must me less than upper limit." ;
        sh:select """
            SELECT $this ?value {
                $this base:hasObservedValue ?value .
            }
        """ ;
    ] .