{
  "SolderBridging": {
    "caused_by": [
      "ExcessPasteVolumePerAperture",
      "ExcessReflowSpreading"
    ]
  },
  "ExcessPasteVolumePerAperture": {
    "caused_by": [
      "ApertureOverfill",
      "UndersideSmear",
      "PostPrintSpread"
    ],
    "governed_by": [
      "If PasteVolumePerAperture > PasteVolumePerAperture_USL → ExcessPasteVolumePerAperture"
    ]
  },
  "ExcessReflowSpreading":{
    "caused_by":[
      "PeakReflowTemperatureTooHigh",
      "TimeAboveLiquidusTooHigh"
    ],
    "governed_by": [
      "If PeakReflowTemperature > PeakReflowTemperature_USL ∨ TimeAboveLiquidus > TimeAboveLiquidus_USL → ExcessReflowSpreading"
    ]
  },
  "ApertureOverfill": {
    "caused_by": [
      "LowAreaRatio",
      "LargeBeadSizeOfSolderPaste",
      "StencilThicknessTooHigh",
      "SqueegeeSpeedTooLow",
      "SqueegeeAngleTooLow"
    ],
    "governed_by": [
      "If ApertureAreaRatio < ApertureAreaRatio_LSL ∨ StencilThickness > StencilThickness_USL → ApertureOverfill",
      "If PasteRollBeadSize > PasteRollBeadSize_USL → ApertureOverfill",
      "If SqueegeeAngle < SqueegeeAngle_LSL ∧ (SqueegeeSpeed < SqueegeeSpeed_LSL ∨ SqueegeePressure > SqueegeePressure_USL) → ApertureOverfill"
    ]
  },
  "UndersideSmear": {
    "caused_by": [
      "SqueegeePressureTooHigh",
      "ResidualPasteVolume"
    ],
    "governed_by": [
      "If SqueegeePressure > SqueegeePressure_USL → UndersideSmear",
      "If ResidualPasteAllowed > ResidualPasteAllowed_USL → UndersideSmear"
    ]
  },
  "PostPrintSpread": {
    "caused_by": [
      "LowPasteViscosity",
      "HighHumidity"
    ],
    "governed_by": [
      "If PasteViscosity < PasteViscosity_LSL ∨ AmbientRh > AmbientRh_USL → PostPrintSpread"
    ]
  },
  "LowPasteViscosity": {
    "caused_by": ["LowMetalContent"],
    "governed_by": [
      "If PasteMetalLoad < PasteMetalLoad_LSL → LowPasteViscosity",
      "If PasteViscosity < PasteViscosity_LSL → LowPasteViscosity"
    ]
  },
  "LowAreaRatio": {
    "caused_by": [],
    "governed_by": [
      "If ApertureAreaRatio < ApertureAreaRatio_LSL → LowAreaRatio"
    ]
  },
  "LargeBeadSizeOfSolderPaste": {
    "caused_by": [],
    "governed_by": [
      "If PasteRollBeadSize > PasteRollBeadSize_USL → LargeBeadSizeOfSolderPaste"
    ]
  },
  "StencilThicknessTooHigh": {
    "caused_by": [],
    "governed_by": [
      "If StencilThickness > StencilThickness_USL → StencilThicknessTooHigh"
    ]
  },
  "SqueegeeSpeedTooLow": {
    "caused_by": [],
    "governed_by": [
      "If SqueegeeSpeed < SqueegeeSpeed_LSL → SqueegeeSpeedTooLow"
    ]
  },
  "SqueegeeAngleTooLow": {
    "caused_by": [],
    "governed_by": [
      "If SqueegeeAngle < SqueegeeAngle_LSL → SqueegeeAngleTooLow"
    ]
  },
  "SqueegeePressureTooHigh": {
    "caused_by": [],
    "governed_by": [
      "If SqueegeePressure > SqueegeePressure_USL → SqueegeePressureTooHigh"
    ]
  },
  "ResidualPasteVolume": {
    "caused_by": [],
    "governed_by": [
      "If ResidualPasteAllowed > ResidualPasteAllowed_USL → ResidualPasteVolume"
    ]
  },
  "HighHumidity": {
    "caused_by": [],
    "governed_by": [
      "If AmbientRh > AmbientRh_USL → HighHumidity"
    ]
  },
  "LowMetalContent": {
    "caused_by": [],
    "governed_by": [
      "If PasteMetalLoad < PasteMetalLoad_LSL → LowMetalContent"
    ]
  },
  "PeakReflowTemperatureTooHigh":{
    "caused_by": [],
    "governed_by": [
      "If PeakReflowTemperature > PeakReflowTemperature_USL → PeakReflowTemperatureTooHigh"
    ]
  },
  "TimeAboveLiquidusTooHigh":{
    "caused_by": [],
    "governed_by": [
      "If TimeAboveLiquidus > TimeAboveLiquidus_USL → TimeAboveLiquidusTooHigh"
    ]
  },
  "OpenCircuit": {
    "caused_by": [
      "NonCoalescence",
      "InsufficientPasteVolumePerAperture"
    ]
  },
  "NonCoalescence":{
    "caused_by": [
      "TimeAboveLiquidusTooLow",
      "PeakReflowTemperatureTooLow"
    ],
    "governed_by": [
      "If PeakReflowTemperature < PeakReflowTemperature_LSL ∨ TimeAboveLiquidus < TimeAboveLiquidus_LSL → NonCoalescence"
    ]
  },
  "InsufficientPasteVolumePerAperture":{
    "caused_by": [
      "SqueegeeSpeedTooHigh",
      "SqueegeePressureTooLow"
    ],
    "governed_by": [
      "If SqueegeeSpeed > SqueegeeSpeed_USL ∨ SqueegeePressure < SqueegeePressure_LSL → InsufficientPasteVolumePerAperture"
    ]
  },
  "TimeAboveLiquidusTooLow":{
    "caused_by": [],
    "governed_by": [
      "If TimeAboveLiquidus < TimeAboveLiquidus_LSL → TimeAboveLiquidusTooLow"
    ]
  },
  "PeakReflowTemperatureTooLow":{
    "caused_by": [],
    "governed_by": [
      "If PeakReflowTemperature < PeakReflowTemperature_LSL → PeakReflowTemperatureTooLow"
    ]
  },
  "SqueegeeSpeedTooHigh": {
    "caused_by": [],
    "governed_by": [
      "If SqueegeeSpeed > SqueegeeSpeed_USL → SqueegeeSpeedTooHigh"
    ]
  },
  "SqueegeePressureTooLow": {
    "caused_by": [],
    "governed_by": [
      "If SqueegeePressure < SqueegeePressure_LSL → SqueegeePressureTooLow"
    ]
  }
}
