<owl:NamedIndividual rdf:about="#SolderBridging_1">
  <rdf:type rdf:resource="#SolderBridging"/>
  <obo:RO_0002559 rdf:resource="#ExcessPasteVolumePerAperture_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SolderBridging_1</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ExcessPasteVolumePerAperture_1">
  <rdf:type rdf:resource="#ExcessPasteVolumePerAperture"/>
  <obo:RO_0002559 rdf:resource="#ApertureOverfill_1"/>
  <obo:RO_0002559 rdf:resource="#UndersideSmear_1"/>
  <obo:RO_0002559 rdf:resource="#PostPrintSpread_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessPasteVolumePerAperture_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteVolumePerAperture &gt; PasteVolumePerAperture_USL → ExcessPasteVolumePerAperture</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ApertureOverfill_1">
  <rdf:type rdf:resource="#ApertureOverfill"/>
  <obo:RO_0002559 rdf:resource="#LowAreaRatio_1"/>
  <obo:RO_0002559 rdf:resource="#LargeBeadSizeOfSolderPaste_1"/>
  <obo:RO_0002559 rdf:resource="#StencilThicknessTooHigh_1"/>
  <obo:RO_0002559 rdf:resource="#SqueegeeSpeedTooLow_1"/>
  <obo:RO_0002559 rdf:resource="#SqueegeeAngleTooLow_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApertureOverfill_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL ∧ StencilThickness ≥ StencilThickness_NOM → ApertureOverfill</governedBy>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL ∧ (SqueegeeSpeed ≤ SqueegeeSpeed_NOM ∨ SqueegeePressure ≥ SqueegeePressure_NOM) → ApertureOverfill ∨ UndersideSmear</governedBy>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → ApertureOverfill</governedBy>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed ≤ SqueegeeSpeed_LSL ∧ (SqueegeeAngle ≤ SqueegeeAngle_NOM ∨ SqueegeePressure ≥ SqueegeePressure_NOM) → ApertureOverfill ∨ UndersideSmear</governedBy>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If StencilThickness &gt; StencilThickness_USL ∧ BGAPitch ≤ BGAPitch_threshold → ApertureOverfill</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LowAreaRatio_1">
  <rdf:type rdf:resource="#LowAreaRatio"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowAreaRatio_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL → LowAreaRatio</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LargeBeadSizeOfSolderPaste_1">
  <rdf:type rdf:resource="#LargeBeadSizeOfSolderPaste"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LargeBeadSizeOfSolderPaste_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → LargeBeadSizeOfSolderPaste</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StencilThicknessTooHigh_1">
  <rdf:type rdf:resource="#StencilThicknessTooHigh"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StencilThicknessTooHigh_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If StencilThickness &gt; StencilThickness_USL → StencilThicknessTooHigh</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SqueegeeSpeedTooLow_1">
  <rdf:type rdf:resource="#SqueegeeSpeedTooLow"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeeSpeedTooLow_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &lt; SqueegeeSpeed_LSL → SqueegeeSpeedTooLow</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SqueegeeAngleTooLow_1">
