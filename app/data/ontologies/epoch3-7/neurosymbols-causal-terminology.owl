<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://neurosymbols.ai/ontology/causal-terminology.owl"
         xmlns="https://neurosymbols.ai/ontology/causal-terminology.owl#"
         xmlns:prov="http://www.w3.org/ns/prov#"
         xmlns:core="http://www.w3.org/2004/02/skos/core#"
         xmlns:obo="http://purl.obolibrary.org/obo/">

<owl:Ontology rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl">
  <owl:imports rdf:resource="https://raw.githubusercontent.com/iofoundry/ontology/master/core/Core.rdf"/>
  <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
  <owl:imports rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
  <owl:imports rdf:resource="http://www.w3.org/ns/prov.owl"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasObservation">
  <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#ParameterObservation"/>
  <owl:inverseOf rdf:resource="#observationOf"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a PCB to its associated parameter observations (e.g., stencil thickness, aperture ratio).</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'PCB-045' hasObservation 'StencilThicknessObs_125um'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#observationOf">
  <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describes"/>
  <owl:inverseOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#ParameterObservation"/>
  <rdfs:range rdf:resource="#PCB"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a parameter observation to the PCB it describes or measures.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'StencilThicknessObs_120um' observationOf 'PCB-045'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isCorrectedBy">
  <rdfs:domain rdf:resource="#FailureCause"/>
  <rdfs:range rdf:resource="#CorrectiveAction"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a failure cause is mitigated or corrected by a corrective action.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'ExcessPasteVolumePerAperture' isCorrectedBy 'ReducePrintPressureAction'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#corrects">
  <rdfs:domain rdf:resource="#CorrectiveAction"/>
  <rdfs:range rdf:resource="#FailureCause"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a corrective action to the failure cause it addresses in semiconductor manufacturing.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'AdjustStencilThickness' corrects 'ExcessReflowSpreading' observed in lot L230.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDefect">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#Defect"/>
  <owl:inverseOf rdf:resource="#defectOccursOn"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Denotes that a PCB exhibits one or more defects detected during inspection.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'PCB-045' hasDefect 'SolderBridging'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#defectOccursOn">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
  <owl:inverseOf rdf:resource="#hasDefect"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#Defect"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates the PCB on which a specific defect is observed during inspection.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'SolderBridging' defectOccursOn 'PCB-045' during AOI inspection.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affects">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
  <rdfs:domain rdf:resource="#FailureCause"/>
  <rdfs:range rdf:resource="#PCB"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a failure cause to the PCB it impacts, representing causal influence in process outcome.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'LowPasteViscosity' affects 'PCB-123' leading to insufficient solder volume.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAffectedBy">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#FailureCause"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a PCB to the failure cause influencing its process outcome or quality.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'PCB-045' isAffectedBy 'ThermalGradientAcrossBoard'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAssessmentInput">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  <rdfs:domain rdf:resource="#ConformanceAssessment"/>
  <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
  <owl:inverseOf rdf:resource="#isAssessmentInputFor"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connects a conformance assessment to the measurement or data it uses as input.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'AOIConformanceCheck' hasAssessmentInput 'PasteVolumeReport-09'.</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAssessmentInputFor">
  <owl:inverseOf rdf:resource="#hasAssessmentInput"/>
  <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
  <rdfs:range rdf:resource="#ConformanceAssessment"/>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shows that an information content entity serves as input to an assessment activity.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: 'PasteInspectionData-01' isAssessmentInputFor 'ConformanceAssessment-Run3'.</core:example>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasUpperValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#triggeredByRule">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasNominalValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLowerValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasObservedValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasUnit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#governedBy">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#CorrectiveAction">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ActionSpecification"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#corrects"/>
      <owl:someValuesFrom rdf:resource="#FailureCause"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CorrectiveAction</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified requirement or acceptable range for 'CorrectiveAction' used in process control and acceptance criteria.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Specification: 'CorrectiveAction' must be between defined limits for a given process (e.g., 0.66–0.80).</core:example>
</owl:Class>

<owl:Class rdf:about="#Defect">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#defectOccursOn"/>
      <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defect</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition for 'Defect' within semiconductor manufacturing context.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example usage of 'Defect' in an SMT process context.</core:example>
</owl:Class>

<owl:Class rdf:about="#FailureCause">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#affects"/>
      <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
      <owl:someValuesFrom rdf:resource="#ConformanceAssessment"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002566"/>
      <owl:someValuesFrom rdf:resource="#Effect"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FailureCause</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition for 'FailureCause' within semiconductor manufacturing context.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example usage of 'FailureCause' in an SMT process context.</core:example>
</owl:Class>

<owl:Class rdf:about="#Effect">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002559"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition for 'Effect' within semiconductor manufacturing context.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example usage of 'Effect' in an SMT process context.</core:example>
</owl:Class>

<owl:Class rdf:about="#PCB">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material product used in assembly: 'PCB', representing the PCB or related product.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: PCB assembly 'MainBoard-01' with 6-layer FR4, dimensions 100x80 mm.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterQuality">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
      <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribedBy"/>
      <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterQuality</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'ParameterQuality' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'ParameterQuality' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterCharacteristic">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ProcessCharacteristic"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
      <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribedBy"/>
      <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterCharacteristic</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A manufacturing process step or activity: 'ParameterCharacteristic', describing a stage in PCB assembly.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: ReflowSolderingProcess applied profile ramp to peak 245°C for 60s time above liquidus.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterObservation">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MeasurementInformationContentEntity"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describes"/>
      <owl:someValuesFrom rdf:resource="#ParameterCharacteristic"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/isAbout"/>
      <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#observationOf"/>
      <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterObservation</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observed measurement of 'ParameterObservation' recorded during manufacturing or inspection (e.g., inline AOI or IPC measurement).</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Inline inspection recorded 'ParameterObservation' = 0.63 for board serial BRD-1001 during print step.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterSpecification">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribes"/>
      <owl:someValuesFrom rdf:resource="#ParameterCharacteristic"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/isSubjectOf"/>
      <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterSpecification</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified requirement or acceptable range for 'ParameterSpecification' used in process control and acceptance criteria.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Specification: 'ParameterSpecification' must be between defined limits for a given process (e.g., 0.66–0.80).</core:example>
</owl:Class>

<owl:Class rdf:about="#ComponentPlacementProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComponentPlacementProcess</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A manufacturing process step or activity: 'ComponentPlacementProcess', describing a stage in PCB assembly.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: ReflowSolderingProcess applied profile ramp to peak 245°C for 60s time above liquidus.</core:example>
</owl:Class>

<owl:Class rdf:about="#ReflowSolderingProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReflowSolderingProcess</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A manufacturing process step or activity: 'ReflowSolderingProcess', describing a stage in PCB assembly.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: ReflowSolderingProcess applied profile ramp to peak 245°C for 60s time above liquidus.</core:example>
</owl:Class>

<owl:Class rdf:about="#SolderPrintingProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SolderPrintingProcess</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A manufacturing process step or activity: 'SolderPrintingProcess', describing a stage in PCB assembly.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: ReflowSolderingProcess applied profile ramp to peak 245°C for 60s time above liquidus.</core:example>
</owl:Class>

<owl:Class rdf:about="#ConformanceAssessment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasAssessmentInput"/>
      <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasAssessmentInput"/>
      <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generated"/>
      <owl:someValuesFrom rdf:resource="#FailureCause"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConformanceAssessment</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Definition for 'ConformanceAssessment' within semiconductor manufacturing context.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example usage of 'ConformanceAssessment' in an SMT process context.</core:example>
</owl:Class>

<owl:Class rdf:about="#BgaBallDiameter">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bga ball diameter</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'bga ball diameter' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'bga ball diameter' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#SolderBallHeight">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solder ball height</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'solder ball height' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'solder ball height' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#NumberOfBalls">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of balls</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'number of balls' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'number of balls' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#SolderAlloy">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solder alloy</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'solder alloy' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'solder alloy' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilThickness">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil thickness</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality parameter describing 'stencil thickness' as a measurable attribute relevant to solder printing or reflow.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Measured 'stencil thickness' = 0.12 mm which is within process capability for this design.</core:example>
</owl:Class>

<owl:Class rdf:about="#ApertureDiameter">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture diameter</rdfs:label>
