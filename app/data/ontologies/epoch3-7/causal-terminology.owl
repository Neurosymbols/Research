  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteMetalLoad &lt; PasteMetalLoad_LSL → LowPasteViscosity</governedBy>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteViscosity &lt; PasteViscosity_LSL → LowPasteViscosity</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HighHumidity_1">
  <rdf:type rdf:resource="#HighHumidity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HighHumidity_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If AmbientRh &gt; AmbientRh_USL → HighHumidity</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LowMetalContent_1">
  <rdf:type rdf:resource="#LowMetalContent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowMetalContent_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteMetalLoad &lt; PasteMetalLoad_LSL → LowMetalContent</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#OpenCircuit_1">
  <rdf:type rdf:resource="#OpenCircuit"/>
  <obo:RO_0002559 rdf:resource="#NonCoalescence_1"/>
  <obo:RO_0002559 rdf:resource="#InsufficientPasteVolumePerAperture_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OpenCircuit_1</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#NonCoalescence_1">
  <rdf:type rdf:resource="#NonCoalescence"/>
  <obo:RO_0002559 rdf:resource="#TimeAboveLiquidusTooLow_1"/>
  <obo:RO_0002559 rdf:resource="#PeakReflowTemperatureTooLow_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NonCoalescence_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &lt; PeakReflowTemperature_LSL ∨ TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL → NonCoalescence</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#InsufficientPasteVolumePerAperture_1">
  <rdf:type rdf:resource="#InsufficientPasteVolumePerAperture"/>
  <obo:RO_0002559 rdf:resource="#SqueegeeSpeedTooHigh_1"/>
  <obo:RO_0002559 rdf:resource="#SqueegeePressureTooLow_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InsufficientPasteVolumePerAperture_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL ∨ SqueegeePressure &lt; SqueegeePressure_LSL → InsufficientPasteVolumePerAperture</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TimeAboveLiquidusTooLow_1">
  <rdf:type rdf:resource="#TimeAboveLiquidusTooLow"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimeAboveLiquidusTooLow_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL → TimeAboveLiquidusTooLow</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PeakReflowTemperatureTooLow_1">
  <rdf:type rdf:resource="#PeakReflowTemperatureTooLow"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PeakReflowTemperatureTooLow_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &lt; PeakReflowTemperature_LSL → PeakReflowTemperatureTooLow</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SqueegeeSpeedTooHigh_1">
  <rdf:type rdf:resource="#SqueegeeSpeedTooHigh"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeeSpeedTooHigh_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL → SqueegeeSpeedTooHigh</governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SqueegeePressureTooLow_1">
  <rdf:type rdf:resource="#SqueegeePressureTooLow"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeePressureTooLow_1</rdfs:label>
  <governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &lt; SqueegeePressure_LSL → SqueegeePressureTooLow</governedBy>
</owl:NamedIndividual>

