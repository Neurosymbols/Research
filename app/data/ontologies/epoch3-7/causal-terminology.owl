</owl:Class>

<owl:Class rdf:about="#ProcessFailureCause">
  <rdfs:subClassOf rdf:resource="#FailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ProcessFailureCause</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QualityFailureCause">
  <rdfs:subClassOf rdf:resource="#FailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QualityFailureCause</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StencilThickness">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil thickness</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nominal thickness of the printing stencil material.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">100 µm stainless steel stencil used for mixed‑technology build.</core:example>
</owl:Class>

<owl:Class rdf:about="#ApertureDiameter">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture diameter</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diameter of a circular stencil aperture used to deposit solder paste onto a circular pad (e.g., BGA land).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 0.23 mm diameter circular aperture is used for a 0.40 mm pitch BGA land.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteRollBeadSize">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste roll bead size</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ApertureAreaRatio">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture area ratio</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensionless ratio used for stencil release in solder paste printing, defined as aperture open area divided by aperture wall area: AAR = (L×W) / (2×(L+W)×T), where L and W are aperture length and width, and T is stencil thickness.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For a 0.30 mm × 0.15 mm aperture in a 0.075 mm stencil: AAR = (0.30×0.15)/(2×(0.30+0.15)×0.075) = 0.67, which meets the typical ≥0.66 guideline.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteViscosity">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste viscosity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resistance of solder paste to flow under shear, commonly measured with a rotational viscometer (e.g., Malcom) at specified speed and temperature.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">165 Pa·s at 25 °C and 10 rpm on a Malcom viscometer.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParticleSizeDistribution">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle size distribution</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution of solder powder particle sizes in a paste, often summarized by D10/D50/D90 and classified by IPC types (e.g., Type 4).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Type 4 powder: ~20–38 µm with D50 ≈ 28 µm, verified by laser diffraction.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTemp">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life temp</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Storage temperature range for sealed solder paste to maintain performance until expiry.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigerated storage at 0–10 °C per supplier datasheet.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTemp">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life temp</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambient temperature range within which an opened solder paste can remain in use on the printer without degradation.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recommended open-life temperature: 20–25 °C on the print floor.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilCoplanarity">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil coplanarity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flatness of the stencil underside relative to the PCB surface during printing; non‑coplanarity introduces variable gasket gaps.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Underside gap up to 0.03 mm observed at board corner, causing thin deposits there.</core:example>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTemp">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone temp</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTemp">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone temp</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakReflowTemperature">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak reflow temperature</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peak reflow temperature out of the qualified window (too high or too low), resulting in poor wetting, excessive spread, or flux exhaustion.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measured peak 255–260 °C for SAC305 causes over‑spreading and discoloration on thin boards.</core:example>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTemp">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone temp</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AmbientRh">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ambient rh</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IonicContamination">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ionic contamination</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amount of ionizable residues on a PCB assembly, typically expressed as µg NaCl equivalent per unit area and measured by ROSE or ion chromatography.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ROSE test result: 0.80 µg NaCl eq/in² after reflow.</core:example>
</owl:Class>

<owl:Class rdf:about="#BoardWarpage">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">board warpage</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Out-of-plane deformation (bow and/or twist) of a bare or assembled PCB, usually expressed as a percentage of the board length/diagonal.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 200 mm PCB with 0.8 mm maximum bow has 0.4% warpage.</core:example>
</owl:Class>

<owl:Class rdf:about="#MetalLoad">
  <rdfs:subClassOf rdf:resource="#ParameterQuality"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metal load</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteVolumePerAperture">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste volume per aperture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ResidualPaste">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">residual paste</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeePressure">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee pressure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeSpeed">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee speed</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeAngle">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee angle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life time</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time interval from manufacture during which sealed paste is expected to meet specification when stored properly.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shelf life: 6 months from date of manufacture at 0–10 °C.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life time</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum time an opened paste may remain in use before disposal or remix/requalification.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typical open-life: 8 hours on the printer at 23 °C.</core:example>
</owl:Class>

<owl:Class rdf:about="#OverprintAllowance">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overprint allowance</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PAndPPlacementAccuracy">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p and p placement accuracy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone time</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone time</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RampUpZoneRateAndTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ramp-up zone rate and time</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakZoneTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak zone time</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTime">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone time</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OxygenLevel">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxygen level</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidus">
  <rdfs:subClassOf rdf:resource="#ParameterCharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time above liquidus</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Duration that solder remains above its liquidus temperature outside the qualified window (too short or too long), affecting wetting and intermetallic growth.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Profile shows TAL ≈ 120 s for SAC305 (too long), causing excessive spread and IMC thickening.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilThicknessObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil thickness obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measured stencil thickness at a specific location.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Micrometer reading: 99.6–100.4 µm across the panel area.</core:example>
</owl:Class>

<owl:Class rdf:about="#ApertureDiameterObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture diameter obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measured value of a specific circular stencil aperture diameter.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measured with optical microscope: aperture diameter = 0.228 mm.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteRollBeadSizeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste roll bead size obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ApertureAreaRatioObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture area ratio obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A recorded calculation of the aperture area ratio for a specific stencil aperture, based on measured or design L, W, and T values.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Job ABC: L=0.30 mm, W=0.15 mm, T=0.075 mm → AAR=0.67 (accepted).</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteViscosityObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste viscosity obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measured viscosity value for a specific paste lot under specified test conditions.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lot SP-22: 170 Pa·s (Malcom, 25 °C, 10 rpm).</core:example>
</owl:Class>

<owl:Class rdf:about="#ParticleSizeDistributionObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle size distribution obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measured particle size distribution for a specific solder paste lot.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lot SP-22: D10=20 µm, D50=28 µm, D90=37 µm (Type 4).</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTempObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life temp obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorded storage temperature for a specific paste lot during shelf life.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data logger shows 5 °C ±2 °C for the entire storage period.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTempObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life temp obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorded ambient temperature during a paste open-life interval.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run logged at 23 °C ±1 °C during an 8-hour open-life window.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilCoplanarityObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil coplanarity obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measured deviation from planarity between stencil underside and PCB surface.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeler gauge shows 0.02–0.03 mm gap at the rear edge of the print window.</core:example>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTempObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone temp obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTempObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone temp obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakReflowTemperatureObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak reflow temperature obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTempObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone temp obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AmbientRhObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ambient rh obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IonicContaminationObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ionic contamination obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measured ionic contamination value for a specific unit, lot, or panel.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Panel 12C: 0.62 µg NaCl eq/in² (pass).</core:example>
</owl:Class>

<owl:Class rdf:about="#BoardWarpageObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">board warpage obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A recorded measurement of PCB bow/twist for a specific board at a stated temperature/fixturing.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Room temperature, supported at corners: warpage = 0.38%.</core:example>
</owl:Class>

<owl:Class rdf:about="#MetalLoadObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metal load obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteVolumePerApertureObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste volume per aperture obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ResidualPasteObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">residual paste obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeePressureObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee pressure obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeSpeedObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee speed obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeAngleObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee angle obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life time obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorded age of a paste lot at the time of use or inspection.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lot SP-22 is 4.2 months old—within 6‑month shelf life.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life time obs</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recorded duration of paste exposure on the printer for a specific run.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paste jar in use for 6.5 hours (within 8-hour limit).</core:example>
</owl:Class>

<owl:Class rdf:about="#OverprintAllowanceObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overprint allowance obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PAndPPlacementAccuracyObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p and p placement accuracy obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone time obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone time obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RampUpZoneRateAndTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ramp-up zone rate and time obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakZoneTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak zone time obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTimeObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone time obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OxygenLevelObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxygen level obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidusObs">
  <rdfs:subClassOf rdf:resource="#ParameterObservation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time above liquidus obs</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StencilThicknessSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil thickness spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required stencil thickness and tolerance for the job or aperture region (including step‑downs/ups if any).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: 100 µm ±5 µm; step‑down to 80 µm in the BGA field.</core:example>
</owl:Class>

<owl:Class rdf:about="#ApertureDiameterSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture diameter spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The required nominal diameter and tolerance for a circular stencil aperture.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: 0.23 ± 0.02 mm for BGA paste apertures.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteRollBeadSizeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste roll bead size spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ApertureAreaRatioSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aperture area ratio spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A requirement specifying the acceptable minimum aperture area ratio for a given design and stencil technology.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: AAR ≥ 0.66 for laser-cut, electropolished stainless steel stencils.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteViscositySpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste viscosity spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required viscosity range and test method for a solder paste.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: 140–220 Pa·s at 25 °C, 10 rpm (Malcom).</core:example>
</owl:Class>

<owl:Class rdf:about="#ParticleSizeDistributionSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle size distribution spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The required particle size distribution/classification for solder paste.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: Type 4 per J-STD-005—90% between 20–38 µm.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTempSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life temp spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required storage temperature range for sealed paste before opening.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: 0–10 °C; do not freeze.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTempSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life temp spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The allowable ambient temperature range for paste open-life.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: 20–25 °C during use; excursions outside range end the open-life.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilCoplanaritySpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stencil coplanarity spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allowable maximum gasket gap/flatness deviation across the print area.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: ≤0.05 mm gap anywhere within the print window.</core:example>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTempSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone temp spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTempSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone temp spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakReflowTemperatureSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak reflow temperature spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTempSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone temp spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AmbientRhSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ambient rh spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IonicContaminationSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ionic contamination spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The maximum allowable ionic contamination for a product under specified test conditions.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: ≤1.00 µg NaCl eq/in² per internal cleanliness requirement.</core:example>
</owl:Class>

<owl:Class rdf:about="#BoardWarpageSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">board warpage spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The allowable PCB warpage under defined conditions (e.g., room temperature and at reflow temperature).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: ≤0.75% bare board at 23 °C; ≤0.50% at reflow temperature.</core:example>
</owl:Class>

<owl:Class rdf:about="#MetalLoadSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metal load spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteVolumePerApertureSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste volume per aperture spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ResidualPasteSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">residual paste spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeePressureSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee pressure spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeSpeedSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee speed spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeAngleSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squeegee angle spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PasteShelfLifeTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste shelf-life time spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum allowable time from manufacture for sealed paste, under specified storage conditions.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: ≤6 months at 0–10 °C.</core:example>
</owl:Class>

<owl:Class rdf:about="#PasteOpenLifeTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paste open-life time spec</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The allowable maximum time for paste usage after opening under specified conditions.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: ≤8 hours at 20–25 °C; beyond this requires paste replacement.</core:example>
</owl:Class>

<owl:Class rdf:about="#OverprintAllowanceSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overprint allowance spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PAndPPlacementAccuracySpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p and p placement accuracy spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PreheatZoneTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preheat zone time spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoakZoneTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soak zone time spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RampUpZoneRateAndTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ramp-up zone rate and time spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakZoneTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak zone time spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CoolDownZoneTimeSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cool down zone time spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OxygenLevelSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxygen level spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidusSpec">
  <rdfs:subClassOf rdf:resource="#ParameterSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time above liquidus spec</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SolderBridging">
  <rdfs:subClassOf rdf:resource="#Defect"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SolderBridging</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unintended solder connection that electrically shorts adjacent conductive features after reflow.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bridge between pins 17–18 on a 0.5 mm pitch QFP causes ICT failure.</core:example>
</owl:Class>

<owl:Class rdf:about="#OpenCircuit">
  <rdfs:subClassOf rdf:resource="#Defect"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OpenCircuit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LowAreaRatio">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowAreaRatio</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aperture area ratio below recommended threshold, causing poor paste release and under-deposits or clogged apertures.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAR=0.55 on 0.30×0.15 mm apertures in a 0.10 mm stencil results in insufficient solder and opens.</core:example>
</owl:Class>

<owl:Class rdf:about="#LargeBeadSizeOfSolderPaste">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LargeBeadSizeOfSolderPaste</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Formation of large solder beads adjacent to chip components after reflow, typically due to excess paste volume, low paste viscosity, or inadequate aperture design.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0402 resistors exhibit beads &gt;0.3 mm on the component side after reflow.</core:example>
</owl:Class>

<owl:Class rdf:about="#StencilThicknessTooHigh">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StencilThicknessTooHigh</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use of a stencil thickness above the qualified value for fine‑pitch features, leading to excessive paste volume and bridging.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">150 µm stencil used with 0.40 mm pitch BGA results in frequent shorts.</core:example>
</owl:Class>

<owl:Class rdf:about="#LowPasteViscosity">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowPasteViscosity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paste viscosity below the required range, often causing excessive post-print spread, bridging, or poor aperture filling.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viscosity 120 Pa·s (Malcom, 25 °C, 10 rpm) vs. spec 160–220 Pa·s; bridges observed on 0.5 mm pitch.</core:example>
</owl:Class>

<owl:Class rdf:about="#HighHumidity">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HighHumidity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambient relative humidity above the allowed range for solder paste handling or storage, promoting slump, oxidation, and inconsistent printing.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Printing at 70% RH causes paste to slump between 0.4 mm pitch pads, increasing bridging defects.</core:example>
</owl:Class>

<owl:Class rdf:about="#PeakReflowTemperatureTooHigh">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PeakReflowTemperatureTooHigh</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeakReflowTemperatureTooLow">
  <rdfs:subClassOf rdf:resource="#QualityFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PeakReflowTemperatureTooLow</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExcessPasteVolumePerAperture">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessPasteVolumePerAperture</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Condition where a single stencil aperture deposits more paste than intended due to oversize aperture, double-printing, or paste scooping.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A misprogrammed double print increases deposit volume by ~60% on 0.5 mm pitch pads, leading to bridges.</core:example>
</owl:Class>

<owl:Class rdf:about="#ApertureOverfill">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApertureOverfill</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paste over-deposit caused by an aperture that effectively prints beyond the intended pad area—due to oversize aperture/overprint, stencil misalignment, or excessive under-stencil paste—increasing risk of bridging or solder beads.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0201 capacitor pads printed with a +10% overprint produce paste spreading into the mask dam and intermittent bridges.</core:example>
</owl:Class>

<owl:Class rdf:about="#SqueegeeSpeedTooLow">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeeSpeedTooLow</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squeegee traverse speed below the qualified range, increasing paste dwell time and risk of over‑filling apertures.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reducing speed from 50 mm/s to 15 mm/s leads to over‑deposits on 0.5 mm pitch pads.</core:example>
</owl:Class>

<owl:Class rdf:about="#SqueegeeAngleTooLow">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeeAngleTooLow</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squeegee blade angle below the qualified range (e.g., &lt;55–60°), promoting paste scooping and excess deposition.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Angle set to 45° results in thick deposits and bridging on fine‑pitch features.</core:example>
</owl:Class>

<owl:Class rdf:about="#UndersideSmear">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UndersideSmear</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeePressureTooHigh">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeePressureTooHigh</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squeegee pressure above the qualified window, causing stencil wear, understencil leakage, and smeared deposits.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure increased to 7 kgf causes paste bleed‑out under the stencil and shorts on QFN pads.</core:example>
</owl:Class>

<owl:Class rdf:about="#ResidualPasteVolume">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ResidualPasteVolume</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solder paste remaining in the stencil aperture after the print stroke, reducing transfer efficiency and causing under‑deposits.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPI indicates 75% transfer efficiency on fine‑pitch pads; 25% residual paste visible in apertures.</core:example>
</owl:Class>

<owl:Class rdf:about="#PostPrintSpread">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PostPrintSpread</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increase in solder paste footprint dimensions after printing but before reflow due to low viscosity, high humidity, or long wait time.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Within 10 minutes of print, deposits extend ~75 µm beyond pad edges on 0.5 mm pitch QFP pads.</core:example>
</owl:Class>

<owl:Class rdf:about="#ExcessReflowSpreading">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessReflowSpreading</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solder wetting and flow beyond pad boundaries during reflow, often driven by high peak temperature, overly active flux, or low mask dam.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On a QFN, solder spreads 150 µm into the solder mask channel and creates a short to the adjacent pad.</core:example>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidusTooHigh">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimeAboveLiquidusTooHigh</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NonCoalescence">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NonCoalescence</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidusTooLow">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimeAboveLiquidusTooLow</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InsufficientPasteVolumePerAperture">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InsufficientPasteVolumePerAperture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeeSpeedTooHigh">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeeSpeedTooHigh</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SqueegeePressureTooLow">
  <rdfs:subClassOf rdf:resource="#ProcessFailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SqueegeePressureTooLow</rdfs:label>
</owl:Class>

