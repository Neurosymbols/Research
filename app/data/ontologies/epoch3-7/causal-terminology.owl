  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A physical defect class representing 'SolderBridging' observed on the assembled board or component.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Solder bridging detected between adjacent pins of an SOIC during ICT testing.</core:example>
</owl:Class>

