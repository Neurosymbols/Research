  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Excess paste volume per aperture observed causing tombstoning of 0402 components in lot L-230.</core:example>
  <triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL ∨ StencilThickness &gt; StencilThickness_USL → ApertureOverfill</triggeredByRuleText>
  <triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL ∧ (SqueegeeSpeed &lt; SqueegeeSpeed_LSL ∨ SqueegeePressure &gt; SqueegeePressure_USL) → ApertureOverfill</triggeredByRuleText>
