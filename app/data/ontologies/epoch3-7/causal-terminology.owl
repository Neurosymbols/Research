  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PeakReflowTemperatureTooLowDisposition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeAboveLiquidusTooLowDisposition">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimeAboveLiquidusTooLowDisposition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InsufficientPasteVolumePerApertureDisposition">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InsufficientPasteVolumePerApertureDisposition</rdfs:label>
</owl:Class>

