<owl:Class rdf:about="#ExcessPasteVolumePerAperture">
  <rdfs:subClassOf rdf:resource="#FailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessPasteVolumePerAperture</rdfs:label>
  <prov:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A causal factor that can lead to defects or process non-conformance related to 'ExcessPasteVolumePerAperture' in SMT assembly.</prov:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Example: Excess paste volume per aperture observed causing tombstoning of 0402 components in lot L-230.</core:example>
  <triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteVolumePerAperture &gt; PasteVolumePerAperture_USL → ExcessPasteVolumePerAperture</triggeredByRuleText>
</owl:Class>

<owl:Class rdf:about="#ApertureOverfill">
  <rdfs:subClassOf rdf:resource="#FailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApertureOverfill</rdfs:label>
