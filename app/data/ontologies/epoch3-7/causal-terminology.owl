<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://neurosymbols.ai/ontology/causal-terminology.owl"
         xmlns="https://neurosymbols.ai/ontology/causal-terminology.owl#"
         xmlns:core="http://www.w3.org/2004/02/skos/core#">

<owl:Ontology rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl">
  <owl:imports rdf:resource="http://www.semanticweb.org/neurosymbols/ontologies/bfo-prov.owl"/>
  <owl:imports rdf:resource="https://neurosymbols.ai/ontology/iof-core.rdf"/>
  <owl:imports rdf:resource="http://www.semanticweb.org/neurosymbols/ontologies/ro-causal-properties.owl"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasObservation">
  <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#ParameterObservation"/>
  <owl:inverseOf rdf:resource="#observationOf"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a PCB to a ParameterObservation record that describes a measured attribute of that unit—including numeric value, unit, method, timestamp, and provenance (sensor, inline metrology, machine log, control system).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB Unit U‑000123 hasObservation PasteVolume_PadU1_17 = 0.050 mm³ (from 3D‑SPI file; includes camera ID, calibration, and timestamp).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#observationOf">
  <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describes"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#ParameterObservation"/>
  <rdfs:range rdf:resource="#PCB"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of hasObservation. Binds a ParameterObservation to the PCB it describes, preserving traceability from measured value back to unit and its data provenance.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PasteViscosityObs_170Pa·s@25 °C observationOf PCB Lot L2025‑W45 (value computed from rheometer data file with method metadata).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isCorrectedBy">
  <rdfs:domain rdf:resource="#FailureCause"/>
  <rdfs:range rdf:resource="#CorrectiveAction"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of corrects. Associates a FailureCause with the CorrectiveAction that addresses the causal mechanism through parameter/spec updates, maintenance, or method change.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FailureCause: LowAreaRatio isCorrectedBy StencilRedesign (increase AAR ≥ 0.66; CAM rev and fab drawing updated).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#corrects">
  <rdfs:domain rdf:resource="#CorrectiveAction"/>
  <rdfs:range rdf:resource="#FailureCause"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a CorrectiveAction specification to the FailureCause it is designed to eliminate or mitigate. The action targets the causal mechanism, not only the observed symptom.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CorrectiveAction: ReflowProfileRetune (reduce peak to 245 °C; TAL 70–80 s per IPC‑7530 profile) corrects FailureCause: PeakReflowTemperature (excess peak detected by inline thermocouples and oven controller logs).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDefect">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#Defect"/>
  <owl:inverseOf rdf:resource="#defectOccursOn"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">States that a specific PCB bears a Defect; the defect is realized on that unit as determined by inspection/test.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB Lot L2025‑W45‑P12 hasDefect OpenSolderJoint on J3 pin 5 (diagnosed by functional test failure corroborated by X‑ray voiding pattern).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#defectOccursOn">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="#hasDefect"/>
  <rdfs:domain rdf:resource="#Defect"/>
  <rdfs:range rdf:resource="#PCB"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a PCB instance with a Defect that inheres in that board. This is the placement relation used when inspection or test confirms the defect on a specific unit/panel.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB Unit U‑000123 defectOccursOn SolderBridging between pads of device U1 (defect confirmed by post‑reflow AOI image and ICT continuity test).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affects">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
  <rdfs:domain rdf:resource="#FailureCause"/>
  <rdfs:range rdf:resource="#PCB"/>
  <owl:inverseOf rdf:resource="#isAffectedBy"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a FailureCause (e.g., parameter excursion, environmental condition, machine state) to a PCB unit or lot whose qualities or behavior are altered as a consequence. Use when the cause has process‑level provenance and the board is the bearer of the effect.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FailureCause: ThermalGradientAcrossBoard (derived from reflow oven thermocouple array and PLC logs) affects PCB Lot L2025‑W45‑P12 (panels observed with skew/tombstoning events).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAffectedBy">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
  <owl:inverseOf rdf:resource="#affects"/>
  <rdfs:domain rdf:resource="#PCB"/>
  <rdfs:range rdf:resource="#FailureCause"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of affects. Declares that a PCB’s realized state was influenced by a named FailureCause determined via causal analysis over multi‑modal evidence.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB Panel P‑019 isAffectedBy LowPasteViscosity (inferred from rheometer logs, printer torque telemetry, and increased post‑print spread observed by vision system).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isDeviationOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FailureCause"/>
  <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  <owl:inverseOf rdf:resource="#hasDeviation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDeviation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <owl:inverseOf rdf:resource="#isDeviationOf"/>
  <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  <rdfs:range rdf:resource="#FailureCause"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#baseOf">
  <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <owl:inverseOf rdf:resource="#hasBase"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBase">
  <owl:inverseOf rdf:resource="#baseOf"/>
  <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRealization">
  <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
  <rdfs:range rdf:resource="#ConformanceAssessment"/>
  <owl:inverseOf rdf:resource="#realizationFor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realizationFor">
  <owl:inverseOf rdf:resource="#hasRealization"/>
  <rdfs:domain rdf:resource="#ConformanceAssessment"/>
  <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAssessmentInput">
  <rdfs:domain rdf:resource="#ConformanceAssessment"/>
  <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
  <owl:inverseOf rdf:resource="#isAssessmentInputFor"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connects a ConformanceAssessment activity to any Information Content Entity used as evidence—including SPI/AOI datasets, X‑ray images, MES/ERP travelers, SPC charts, machine/PLC logs, and sensor streams.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConformanceAssessment: COA‑PCB1‑paste_volume_rule hasAssessmentInput SPI_3D_Deposit_Map (CSV+images), Oven_Profile_TCs (JSON), and Printer_Setup_Log (CSV).</core:example>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAssessmentInputFor">
  <owl:inverseOf rdf:resource="#hasAssessmentInput"/>
  <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
  <rdfs:range rdf:resource="#ConformanceAssessment"/>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of hasAssessmentInput. Indicates that a data artifact (document, image, log, sensor file) serves as input evidence to a specific ConformanceAssessment activity.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oven_Profile_TCs_2025‑11‑05.json isAssessmentInputFor COA‑PCB1‑paste_volume_rule (profile used to validate TAL window before rule evaluation).</core:example>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasUpperValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#triggeredByRule">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasNominalValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLowerValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasObservedValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasUnit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#governedBy">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#triggeredByRuleText"/>

<owl:Class rdf:about="#PCB">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCB</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Printed Circuit Board substrate and interconnect structure onto which components are assembled.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Four-layer FR-4 PCB, 1.6 mm thick, ENIG finish, green solder mask.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterObservation">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MeasurementInformationContentEntity"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describes"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ParameterQuality"/>
                <rdf:Description rdf:about="#ParameterCharacteristic"/>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/isAbout"/>
          <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#observationOf"/>
          <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterObservation</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An information record capturing the measured value(s), method, unit, and context for a specific parameter.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPI report entry: paste volume = 350 nL, threshold = ±15%, board SN 12345.</core:example>
</owl:Class>

<owl:Class rdf:about="#FailureCause">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#affects"/>
          <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
          <owl:someValuesFrom rdf:resource="#ConformanceAssessment"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/directlyCausallyInfluences"/>
          <owl:someValuesFrom rdf:resource="#Effect"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FailureCause</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A factor, parameter excursion, or condition that can produce a defect or undesired effect when realized in a process.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low area ratio in stencil apertures causing insufficient paste release and opens.</core:example>
</owl:Class>

<owl:Class rdf:about="#CorrectiveAction">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ActionSpecification"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#corrects"/>
      <owl:someValuesFrom rdf:resource="#RootCause"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CorrectiveAction</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An authorized, documented action plan intended to eliminate the root cause of a detected nonconformity and prevent recurrence.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduce stencil thickness from 120 µm to 100 µm and update print parameters to eliminate bridging on 0.4 mm pitch BGA.</core:example>
</owl:Class>

<owl:Class rdf:about="#Defect">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#defectOccursOn"/>
      <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defect</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nonconforming material or process state that degrades functionality, reliability, or compliance (e.g., opens, shorts, voids).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solder bridge shorting pins 17–18 of a QFP device.</core:example>
</owl:Class>

<owl:Class rdf:about="#ConformanceAssessment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasAssessmentInput"/>
          <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MeasurementInformationContentEntity"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generated"/>
          <owl:someValuesFrom rdf:resource="#FailureCause"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConformanceAssessment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Planned evaluation to determine whether a product or process meets stated requirements or standards.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First-article inspection comparing solder paste SPI data and placement Cpk to the build spec.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterQuality">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
          <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribedBy"/>
          <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
          <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterQuality</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurable attribute that inheres in a material, component, or process (e.g., thickness, viscosity, diameter).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stencil thickness and paste viscosity are ParameterQualities.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterCharacteristic">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ProcessCharacteristic"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/describedBy"/>
          <owl:someValuesFrom rdf:resource="#ParameterObservation"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribedBy"/>
          <owl:someValuesFrom rdf:resource="#ParameterSpecification"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
          <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterCharacteristic</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A named attribute of a process parameter that can be specified, controlled, and measured (e.g., speed, pressure, temperature).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In stencil printing, squeegee speed and pressure are controlled ParameterCharacteristics.</core:example>
</owl:Class>

<owl:Class rdf:about="#ParameterSpecification">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/prescribes"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ParameterQuality"/>
                <rdf:Description rdf:about="#ParameterCharacteristic"/>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
          <owl:someValuesFrom rdf:resource="#ProductProcessSpecificationDocument"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParameterSpecification</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A requirement that constrains an attribute or parameter by target, tolerance, range, unit, and test method.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spec: stencil thickness 100 µm ±5 µm, measured per optical micrometer method.</core:example>
</owl:Class>

<owl:Class rdf:about="#Effect">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/directlyCausallyInfluencedBy"/>
      <owl:someValuesFrom rdf:resource="#FailureCause"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An observable outcome or state resulting from a cause or set of causes in manufacturing or use.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Head-in-pillow (effect) resulting from warpage mismatch and insufficient time above liquidus.</core:example>
</owl:Class>

<owl:Class rdf:about="#RootCause">
  <rdfs:subClassOf rdf:resource="#FailureCause"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RootCause</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most fundamental, addressable cause of a problem which, if corrected, prevents recurrence.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Investigation shows squeegee angle at 45° was the root cause of widespread bridging; corrected to 60°.</core:example>
</owl:Class>

