  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SolderPaste">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solder Paste</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Stencil">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PieceOfEquipment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stencil</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SolderPrintingProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SolderPrintingProcess</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process that transfers solder paste through a stencil onto PCB lands using a squeegee under controlled speed, pressure, and angle.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Printing with 100 µm stainless stencil, 60° polyurethane squeegee, 40 mm/s, 5 kgf pressure.</core:example>
</owl:Class>

<owl:Class rdf:about="#SolderPrintingInspectionProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SolderPrintingInspectionProcess</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ComponentPlacementProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComponentPlacementProcess</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automated or manual operation that picks packaged components and places them onto printed solder paste or adhesive at specified positions and orientations.</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-speed mounter places 0402 passives and a fine-pitch QFP within ±50 µm accuracy.</core:example>
</owl:Class>

<owl:Class rdf:about="#ReflowSolderingProcess">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReflowSolderingProcess</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal process that melts solder paste and forms metallurgical joints according to a defined temperature profile (preheat, soak, reflow, cool).</core:definition>
  <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forced‑convection reflow with SAC305: TAL 60–90 s, peak 245 °C, ramp 1 °C/s.</core:example>
</owl:Class>

<owl:Class rdf:about="#SolderPrinter">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PieceOfEquipment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solder Printer</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ReflowOven">
  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PieceOfEquipment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reflow Oven</rdfs:label>
</owl:Class>

