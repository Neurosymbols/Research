  <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlanSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Product Process Specification Document</rdfs:label>
</owl:Class>

