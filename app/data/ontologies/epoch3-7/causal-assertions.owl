  <obo:directlyCausallyInfluencedBy rdf:resource="#LargeBeadSizeOfSolderPaste_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#StencilThicknessTooHigh_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#SqueegeeSpeedTooLow_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#SqueegeeAngleTooLow_1"/>
  <caus:affects rdf:resource="#PCB_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApertureOverfill_1</rdfs:label>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL ∨ StencilThickness &gt; StencilThickness_USL → ApertureOverfill</caus:governedBy>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → ApertureOverfill</caus:governedBy>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL ∧ (SqueegeeSpeed &lt; SqueegeeSpeed_LSL ∨ SqueegeePressure &gt; SqueegeePressure_USL) → ApertureOverfill</caus:governedBy>
</owl:NamedIndividual>

