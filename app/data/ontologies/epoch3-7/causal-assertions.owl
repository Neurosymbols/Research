<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowAreaRatio">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL → LowAreaRatio</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LargeBeadSizeOfSolderPaste">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → LargeBeadSizeOfSolderPaste</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#StencilThicknessTooHigh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If StencilThickness &gt; StencilThickness_USL → StencilThicknessTooHigh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowPasteViscosity">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteViscosity &lt; PasteViscosity_LSL → LowPasteViscosity</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#HighHumidity">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If AmbientRh &gt; AmbientRh_USL → HighHumidity</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#PeakReflowTemperatureTooHigh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &gt; PeakReflowTemperature_USL → PeakReflowTemperatureTooHigh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#PeakReflowTemperatureTooLow">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &lt; PeakReflowTemperature_LSL → PeakReflowTemperatureTooLow</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ExcessPasteVolumePerAperture">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteVolumePerAperture &gt; PasteVolumePerAperture_USL → ExcessPasteVolumePerAperture</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ApertureOverfill">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL ∧ (SqueegeeSpeed &lt; SqueegeeSpeed_LSL ∨ SqueegeePressure &gt; SqueegeePressure_USL) → ApertureOverfill</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → ApertureOverfill</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL ∨ StencilThickness &gt; StencilThickness_USL → ApertureOverfill</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#SqueegeeSpeedTooLow">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &lt; SqueegeeSpeed_LSL → SqueegeeSpeedTooLow</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#SqueegeeAngleTooLow">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL → SqueegeeAngleTooLow</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#UndersideSmear">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ResidualPasteAllowed &gt; ResidualPasteAllowed_USL → UndersideSmear</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &gt; SqueegeePressure_USL → UndersideSmear</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#SqueegeePressureTooHigh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &gt; SqueegeePressure_USL → SqueegeePressureTooHigh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ResidualPasteVolume">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ResidualPasteAllowed &gt; ResidualPasteAllowed_USL → ResidualPasteVolume</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#PostPrintSpread">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteViscosity &lt; PasteViscosity_LSL ∨ AmbientRh &gt; AmbientRh_USL → PostPrintSpread</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ExcessReflowSpreading">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &gt; PeakReflowTemperature_USL ∨ TimeAboveLiquidus &gt; TimeAboveLiquidus_USL → ExcessReflowSpreading</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#TimeAboveLiquidusTooHigh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If TimeAboveLiquidus &gt; TimeAboveLiquidus_USL → TimeAboveLiquidusTooHigh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#NonCoalescence">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &lt; PeakReflowTemperature_LSL ∨ TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL → NonCoalescence</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#TimeAboveLiquidusTooLow">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL → TimeAboveLiquidusTooLow</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#InsufficientPasteVolumePerAperture">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL ∨ SqueegeePressure &lt; SqueegeePressure_LSL → InsufficientPasteVolumePerAperture</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#SqueegeeSpeedTooHigh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL → SqueegeeSpeedTooHigh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#SqueegeePressureTooLow">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &lt; SqueegeePressure_LSL → SqueegeePressureTooLow</caus:triggeredByRuleText>
</rdf:Description>


</rdf:RDF>
