<owl:NamedIndividual rdf:about="#ExcessPasteVolumePerAperture_1">
  <rdf:type rdf:resource="https://neurosymbols.ai/ontology/causal-terminology.owl#ExcessPasteVolumePerAperture"/>
  <caus:affects rdf:resource="#PCB_1"/>
  <prov:wasGeneratedBy rdf:resource="#COA_ExcessPasteVolumePerAperture_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#ApertureOverfill_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#UndersideSmear_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#PostPrintSpread_1"/>
  <caus:isDeviationOf rdf:resource="#S3-processcharacteristic"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessPasteVolumePerAperture_1</rdfs:label>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteVolumePerAperture &gt; PasteVolumePerAperture_USL → ExcessPasteVolumePerAperture</caus:governedBy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ExcessReflowSpreading_1">
  <rdf:type rdf:resource="https://neurosymbols.ai/ontology/causal-terminology.owl#ExcessReflowSpreading"/>
