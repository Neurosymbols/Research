  <prov:wasGeneratedBy rdf:resource="#COA_ExcessReflowSpreading_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#PeakReflowTemperatureTooHigh_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#TimeAboveLiquidusTooHigh_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessReflowSpreading_1</rdfs:label>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &gt; PeakReflowTemperature_USL ∨ TimeAboveLiquidus &gt; TimeAboveLiquidus_USL → ExcessReflowSpreading</caus:governedBy>
</owl:NamedIndividual>

