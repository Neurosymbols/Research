<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LargeBeadSizeOfSolderPaste">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteRollBeadSize &gt; PasteRollBeadSize_USL → LargeBeadSizeOfSolderPaste</caus:triggeredByRuleText>
