  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ApertureOverfill_1</rdfs:label>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL OR StencilThickness &gt; StencilThickness_USL == ApertureOverfill</caus:governedBy>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL AND (SqueegeeSpeed &lt; SqueegeeSpeed_LSL OR SqueegeePressure &gt; SqueegeePressure_USL) == ApertureOverfill</caus:governedBy>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &lt; SqueegeeSpeed_LSL == ApertureOverfill</caus:governedBy>
</owl:NamedIndividual>

