        <dc:identifier>229-BFO</dc:identifier>
        <rdfs:label xml:lang="en">member part of at all times</rdfs:label>
        <skos:definition xml:lang="en">b member part of c at all times =Def for all times t, b exists at t implies (b is an object &amp; c is an object aggregate &amp; there is at t a mutually exhaustive and pairwise disjoint partition of c into objects x1,..., xn (for some n ≠ 1) with b = xi (for some 1 &lt;= i &lt;= n))</skos:definition>
        <skos:prefLabel xml:lang="en">member part of at all times</skos:prefLabel>
    </owl:ObjectProperty>
    


