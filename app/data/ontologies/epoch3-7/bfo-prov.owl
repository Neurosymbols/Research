        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>116-BFO</dc:identifier>
        <rdfs:label xml:lang="en">proper temporal part of</rdfs:label>
        <skos:definition xml:lang="en">b proper temporal part of c =Def b temporal part of c &amp; not (b = c)</skos:definition>
        <skos:example xml:lang="en">As for temporal part of.</skos:example>
        <skos:prefLabel xml:lang="en">proper temporal part of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000137 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000137">
