        <dc:identifier>245-BFO</dc:identifier>
        <rdfs:label xml:lang="en">material basis of at all times</rdfs:label>
        <skos:definition xml:lang="en">b material basis of c at all times =Def for all times t, b exists at t implies (c has material basis b at t)</skos:definition>
        <skos:prefLabel xml:lang="en">material basis of at all times</skos:prefLabel>
    </owl:ObjectProperty>
    


