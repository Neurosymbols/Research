        <dc:identifier>243-BFO</dc:identifier>
        <rdfs:label xml:lang="en">has material basis at all times</rdfs:label>
        <skos:definition xml:lang="en">b has material basis c at all times =Def For all times t, b exists at t implies (b is a disposition &amp; c is a material entity &amp; there is some d bearer of b &amp; c continuant part of d at t &amp; d has disposition b because c continuant part of d at t)</skos:definition>
        <skos:prefLabel xml:lang="en">has material basis at all times</skos:prefLabel>
    </owl:ObjectProperty>
    


