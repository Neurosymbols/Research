        <rdfs:label xml:lang="en">has proper continuant part at all times</rdfs:label>
        <skos:definition xml:lang="en">b has proper continuant part c at all times =Def c proper continuant part of b at all times</skos:definition>
        <skos:prefLabel xml:lang="en">has proper continuant part at all times</skos:prefLabel>
    </owl:ObjectProperty>
    


