        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Plan"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Role"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Start"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Usage"/>
        <dc:identifier>138-BFO</dc:identifier>
        <rdfs:label xml:lang="en">history</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity</skos:definition>
        <skos:example xml:lang="en">The life of an organism from the beginning to the end of its existence</skos:example>
        <skos:prefLabel xml:lang="en">history</skos:prefLabel>
    </owl:Class>
    


