        <dc:identifier>084-BFO</dc:identifier>
        <rdfs:label xml:lang="en">process boundary</rdfs:label>
        <skos:definition xml:lang="en">p is a process boundary =Def p is a temporal part of a process &amp; p has no proper temporal parts</skos:definition>
        <skos:example xml:lang="en">The boundary between the 2nd and 3rd year of your life</skos:example>
        <skos:prefLabel xml:lang="en">process boundary</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#equivalentClass"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:comment xml:lang="en">A prov:InstantaneousEvent is equivalent to a process boundary because it is referred to as the boundary (start or end) of a prov:Activity as an occurrent.</rdfs:comment>
        <sssom:object_label>process boundary</sssom:object_label>
    </owl:Axiom>
    


