  <obo:directlyCausallyInfluencedBy rdf:resource="#HighPeakReflowTemperature_1"/>
  <obo:directlyCausallyInfluencedBy rdf:resource="#HighTimeAboveLiquidus_1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExcessReflowSpreading_1</rdfs:label>
  <caus:governedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &gt; PeakReflowTemperature_USL OR TimeAboveLiquidus &gt; TimeAboveLiquidus_USL == ExcessReflowSpreading</caus:governedBy>
</owl:NamedIndividual>

