</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowStencilThickness">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If StencilThickness &lt; StencilThickness_LSL == LowStencilThickness</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#HighPasteViscosity">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteViscosity &gt; PasteViscosity_USL == HighPasteViscosity</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowAmbientRh">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If AmbientRh &lt; AmbientRh_LSL == LowAmbientRh</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ApertureOverfill">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL AND (SqueegeeSpeed &lt; SqueegeeSpeed_LSL OR SqueegeePressure &gt; SqueegeePressure_USL) == ApertureOverfill</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ApertureAreaRatio &lt; ApertureAreaRatio_LSL OR StencilThickness &gt; StencilThickness_USL == ApertureOverfill</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &lt; SqueegeeSpeed_LSL == ApertureOverfill</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowSqueegeeSpeed">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &lt; SqueegeeSpeed_LSL == LowSqueegeeSpeed</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowSqueegeeAngle">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeAngle &lt; SqueegeeAngle_LSL == LowSqueegeeAngle</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#UndersideSmear">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &gt; SqueegeePressure_USL OR ResidualPaste &gt; ResidualPaste_USL == UndersideSmear</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#HighSqueegeePressure">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &gt; SqueegeePressure_USL == HighSqueegeePressure</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ResidualPasteVolume">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If ResidualPaste &gt; ResidualPaste_USL == ResidualPasteVolume</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#PostPrintSpread">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PasteViscosity &lt; PasteViscosity_LSL OR AmbientRh &gt; AmbientRh_USL == PostPrintSpread</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#ExcessReflowSpreading">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &gt; PeakReflowTemperature_USL OR TimeAboveLiquidus &gt; TimeAboveLiquidus_USL == ExcessReflowSpreading</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#HighTimeAboveLiquidus">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If TimeAboveLiquidus &gt; TimeAboveLiquidus_USL == HighTimeAboveLiquidus</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#NonCoalescence">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If PeakReflowTemperature &lt; PeakReflowTemperature_LSL OR TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL == NonCoalescence</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowTimeAboveLiquidus">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If TimeAboveLiquidus &lt; TimeAboveLiquidus_LSL == LowTimeAboveLiquidus</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#PoorPasteTransfer">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If StencilThickness &lt; StencilThickness_LSL OR PasteViscosity &gt; PasteViscosity_USL == PoorPasteTransfer</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL OR SqueegeePressure &lt; SqueegeePressure_LSL == PoorPasteTransfer</caus:triggeredByRuleText>
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If AmbientRh &lt; AmbientRh_LSL AND PasteViscosity &gt; PasteViscosity_USL == PoorPasteTransfer</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#HighSqueegeeSpeed">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeeSpeed &gt; SqueegeeSpeed_USL == HighSqueegeeSpeed</caus:triggeredByRuleText>
</rdf:Description>

<rdf:Description rdf:about="https://neurosymbols.ai/ontology/causal-terminology.owl#LowSqueegeePressure">
  <caus:triggeredByRuleText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If SqueegeePressure &lt; SqueegeePressure_LSL == LowSqueegeePressure</caus:triggeredByRuleText>
</rdf:Description>


